# ---- Contact form (all REQUIRED in production; the form refuses to submit without them) ----
# Cloudflare Turnstile. The site key is public by design; the secret stays server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
# Resend.
RESEND_API_KEY=
# Comma-separated recipients and the verified sender address.
CONTACT_NOTIFICATION_EMAIL=
CONTACT_FROM_EMAIL=

# In development, leave all unset: Cloudflare's always-pass test keys are used and submissions are
# validated and logged but NOT emailed.
